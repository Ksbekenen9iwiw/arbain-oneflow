  "devDependencies": {
    "@astryxdesign/cli": "^0.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.0",
    "@astryxdesign/theme-neutral": "^0.7.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "scripts": {
    "build": "npm run build:loading && vite build",
    "dev": "vite build --watch",
